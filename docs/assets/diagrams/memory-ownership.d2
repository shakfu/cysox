direction: down

title: |md
  # Memory Ownership Model
|

owns: "Owning Objects (owner=True)" {
  style: {
    fill: "#e8f5e9"
    stroke: "#2E7D32"
  }

  Format: "Format" {
    shape: class
    style.fill: "#c8e6c9"
    "alloc: sox_open_read() / sox_open_write()"
    "dealloc: sox_close() if generation matches"
  }

  EffectsChain: "EffectsChain" {
    shape: class
    style.fill: "#c8e6c9"
    "alloc: sox_create_effects_chain()"
    "dealloc: sox_delete_effects_chain() if generation matches"
  }

  Effect: "Effect" {
    shape: class
    style.fill: "#c8e6c9"
    "alloc: sox_create_effect(handler)"
    "dealloc: free(ptr)"
  }

  SignalInfo: "SignalInfo" {
    shape: class
    style.fill: "#c8e6c9"
    "alloc: calloc(1, sizeof(...))"
    "dealloc: free(ptr.mult); free(ptr)"
  }

  EncodingInfo: "EncodingInfo" {
    shape: class
    style.fill: "#c8e6c9"
    "alloc: calloc(1, sizeof(...))"
    "dealloc: free(ptr)"
  }

  OutOfBand: "OutOfBand" {
    shape: class
    style.fill: "#c8e6c9"
    "alloc: calloc(1, sizeof(...))"
    "dealloc: sox_delete_comments(); free(ptr)"
  }
}

snapshot: "Snapshots (owner=True, copied out)" {
  style: {
    fill: "#e3f2fd"
    stroke: "#1565C0"
  }

  sig_s: "SignalInfo (snapshot)" {
    shape: class
    style.fill: "#bbdefb"
    "format.signal copies the values out"
    "Independent of the Format; does not track it"
    "A view here let effects overwrite the input"
  }
}

borrows: "Borrowed References (owner=False, keepalive held)" {
  style: {
    fill: "#fff3e0"
    stroke: "#E65100"
  }

  enc_b: "EncodingInfo (borrowed)" {
    shape: class
    style.fill: "#ffe0b2"
    "ptr = &format.encoding (inside sox_format_t)"
    "Keepalive stops the Format being collected"
    "But NOT stale after Format.close()"
  }

  eff_b: "Effect (borrowed)" {
    shape: class
    style.fill: "#ffe0b2"
    "ptr from chain's effects table"
    "Keepalive holds the parent chain"
  }
}

static: "Static / Global (never freed)" {
  style: {
    fill: "#f3e5f5"
    stroke: "#7B1FA2"
  }

  EffectHandler: "EffectHandler" {
    shape: class
    style.fill: "#e1bee7"
    "Static pointer from sox_find_effect()"
    "Lives for entire program lifetime"
  }

  Globals: "Globals" {
    shape: class
    style.fill: "#e1bee7"
    "sox_get_globals() / sox_get_effects_globals()"
    "Lives for entire program lifetime"
  }
}

factory: "from_ptr() Factory Pattern" {
  shape: page
  style: {
    fill: "#eceff1"
    stroke: "#546E7A"
  }
  desc: |md
    Every Cython class provides:
    `ClassName.from_ptr(ptr, owner=False, keepalive=None)`
    - owner=True: we allocated, we free
    - owner=False: borrowed, no dealloc
    - keepalive: strong ref to whoever owns the memory
    Plus an init generation on Format and EffectsChain,
    so objects outliving sox_quit() skip cleanup.
  |
}

owns.Format -> snapshot.sig_s: "format.signal copies" {
  style.stroke-dash: 4
}
owns.Format -> borrows.enc_b: "format.encoding creates" {
  style.stroke-dash: 4
}
owns.EffectsChain -> borrows.eff_b: "chain.effects[] creates" {
  style.stroke-dash: 4
}
